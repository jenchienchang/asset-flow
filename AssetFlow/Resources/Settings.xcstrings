    "Authentication failed. Try again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驗證失敗，請再試一次。"
          }
        }
      }
    },
    "Backup exported successfully." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份匯出成功。"
          }
        }
      }
    },
    "Backup restored successfully." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份還原成功。"
          }
        }
      }
    },
    "Complete" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整"
          }
        }
      }
    },
    "Configure when AssetFlow requires authentication. \"When Switching Apps\" applies when you Cmd+Tab or click another window. \"When Locked or Sleeping\" applies when you lock the screen or your Mac sleeps. Set either to \"Never\" to skip locking for that trigger. Depending on your Mac and settings, macOS may offer Touch ID, Apple Watch, or your system password." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 AssetFlow 何時需要驗證。「切換應用程式時」適用於使用 Cmd+Tab 或點按其他視窗時。「鎖定螢幕或睡眠時」適用於鎖定螢幕或 Mac 進入睡眠時。將任一項設為「永不」可略過該觸發條件的鎖定。視您的 Mac 與系統設定而定，macOS 可能提供 Touch ID、Apple Watch 或系統密碼作為解鎖方式。"
          }
        }
      }
    },
    "Immediately" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即"
          }
        }
      }
    },
    "Long" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細"
          }
        }
      }
    },
    "Never" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不"
          }
        }
      }
    },
    "Numeric" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數字"
          }
        }
      }
    },
    "Unlock AssetFlow to access your portfolio data" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解鎖 AssetFlow 以存取您的投資組合資料"
          }
        }
      }
    },
    "When enabled, AssetFlow will require authentication after switching apps, locking the screen, or waking from sleep." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，當您切換應用程式、鎖定螢幕或從睡眠喚醒時，AssetFlow 會要求驗證。"
          }
        }
      }
    }
  },
  "version" : "1.1"
