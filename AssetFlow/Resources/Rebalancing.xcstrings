{
  "sourceLanguage" : "en",
  "strings" : {
    "Decrease <%@" : {
      "comment" : "A negative nonzero change smaller than one display unit. The placeholder is a positive formatted threshold, with a currency code only when the table needs it. Never describe this as zero.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "減少不到 %@"
          }
        }
      }
    },
    "Increase <%@" : {
      "comment" : "A positive nonzero change smaller than one display unit. The placeholder is a positive formatted threshold, with a currency code only when the table needs it. Never describe this as zero.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加不到 %@"
          }
        }
      }
    },
    "Buy %@" : {
      "comment" : "Action text for a rebalancing suggestion to buy assets. The argument is the formatted currency amount.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "買入 %@"
          }
        }
      }
    },
    "Minimum balances exceed the portfolio value by %@. Add funds or lower the minimums to meet all requirements." : {
      "comment" : "Category goals: minimum is a mandatory lower bound; pool percentage differs from share of total portfolio. Amount placeholders are already formatted with currency.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最低餘額合計超過投資組合價值 %@。請增加資金或降低最低餘額，以滿足所有需求。"
          }
        }
      }
    },
    "Move %@ from %@ to %@" : {
      "comment" : "Summary text suggesting moving a currency amount from one category to another. Arguments: amount, source category, destination category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move %1$@ from %2$@ to %3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 %1$@ 從「%2$@」移至「%3$@」"
          }
        }
      }
    },
    "No action needed" : {
      "comment" : "Action text displayed when a category's adjustment is below the $1 threshold (SPEC 11.4).",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需操作"
          }
        }
      }
    },
    "Percentage targets sum to %@. Set their total to 100%% to calculate rebalancing." : {
      "comment" : "Percentage-sum diagnostic. The amount placeholder is formatted; %% displays one literal percent sign.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標比例合計為 %@。請將合計設為 100%%，以計算再平衡。"
          }
        }
      }
    },
    "Protected balances leave a funding shortfall of %@. Add funds or change category goals to make funds available for rebalancing." : {
      "comment" : "Category goals: minimum is a mandatory lower bound; pool percentage differs from share of total portfolio. Amount placeholders are already formatted with currency.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留餘額造成 %@ 的資金缺口。請增加資金或變更類別目標，讓資金可用於再平衡。"
          }
        }
      }
    },
    "Rebalancing is unavailable because the portfolio data or goal configuration is invalid." : {
      "comment" : "Category goals: minimum is a mandatory lower bound; pool percentage differs from share of total portfolio. Amount placeholders are already formatted with currency.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投資組合資料或目標設定無效，因此無法計算再平衡。"
          }
        }
      }
    },
    "Sell %@" : {
      "comment" : "Action text for a rebalancing suggestion to sell assets. The argument is the formatted currency amount.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賣出 %@"
          }
        }
      }
    },
    "Set percentage targets or minimum balances on your categories." : {
      "comment" : "Category goals: minimum is a mandatory lower bound; pool percentage differs from share of total portfolio. Amount placeholders are already formatted with currency.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
