  "strings" : {
    "Current allocation differs from the effective target by more than 5 percentage points.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前比例與調整後目標相差超過 5 個百分點。"
          }
        }
      },
      "extractionState": "manual"
    },
    "A category named '%@' already exists." : {
      "comment" : "An error message displayed when trying to create a new category with a name that already exists. The argument is the name of the duplicated category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名為「%@」的類別已存在。"
          }
        }
      }
    },
    "Add a snapshot to assess the minimum balance." : {
      "comment" : "Category goals: minimum is a mandatory lower bound; pool percentage differs from share of total portfolio. Amount placeholders are already formatted with currency.",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增快照以評估最低餘額。"
          }
        }
      }
    },
    "Category name cannot be empty." : {
      "localizations" : {
