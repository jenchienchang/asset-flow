{
  "sourceLanguage" : "en",
  "strings" : {
    "AssetFlow could not open its database due to an incompatible schema. Your data has not been deleted.\n\nPlease file an issue at the GitHub repository so we can help resolve this.\n\nError: %@" : {
      "comment" : "The text in the \"Informative Text\" field of an NSAlert that appears when AssetFlow cannot open its database.",
