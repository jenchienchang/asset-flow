      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AssetFlow 因資料庫結構不相容而無法開啟。您的資料並未被刪除。\n\n請至 GitHub 儲存庫提交問題回報，我們將協助您解決此問題。\n\n錯誤：%@"
          }
        }
      }
    },
